# Server
PORT=5000
NODE_ENV=development

# Optional: extra allowed CORS origins (comma-separated), e.g. your Vercel preview URL
# CORS_ORIGINS=https://your-app.vercel.app,https://staging.example.com

# Database — Neon: paste connection string from dashboard (use pooled URL for server apps)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Optional: stricter SSL (default for Neon in code is looser for compatibility)
# DB_SSL_STRICT=true

# Local Postgres (only if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=captaindiscount
# DB_USER=postgres
# DB_PASS=

# JWT
JWT_SECRET=change-me
JWT_EXPIRES=1d

# Super Admin bootstrap
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# SMTP (optional)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
